{
	"name": "pl_cdc_demo",
	"properties": {
		"activities": [
			{
				"name": "lkp_old_watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT last_watermark\nFROM pharma_mes.cdc_demo_watermark\nWHERE table_name = 'cdc_demo_stock_movements'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_cdc_demo",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "lkp_new_watermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT MAX(last_modified) AS new_watermark\nFROM pharma_mes.cdc_demo_stock_movements",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "ds_sql_cdc_demo",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "cp_cdc_demo_changes",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "lkp_new_watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "lkp_old_watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "@concat('SELECT * FROM pharma_mes.cdc_demo_stock_movements WHERE last_modified > ''', activity('lkp_old_watermark').output.firstRow.last_watermark, ''' AND last_modified <= ''', activity('lkp_new_watermark').output.firstRow.new_watermark, '''')",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "ds_sql_cdc_demo",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_adls_cdc_demo_parquet",
						"type": "DatasetReference",
						"parameters": {
							"file_name": {
								"value": "@concat('cdc_demo_', formatDateTime(utcNow(), 'yyyyMMddHHmmss'), '.parquet')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "scr_update_watermark",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "cp_cdc_demo_changes",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_sqldb_pharma",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "NonQuery",
							"text": {
								"value": "UPDATE pharma_mes.cdc_demo_watermark SET last_watermark = '@{activity('lkp_new_watermark').output.firstRow.new_watermark}' WHERE table_name = 'cdc_demo_stock_movements'",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "dbx_cdc_demo",
				"type": "DatabricksJob",
				"dependsOn": [
					{
						"activity": "scr_update_watermark",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"jobId": "161639958977401"
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks",
					"type": "LinkedServiceReference"
				}
			}
		],
		"annotations": []
	}
}