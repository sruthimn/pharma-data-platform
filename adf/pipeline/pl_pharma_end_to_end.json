{
	"name": "pl_pharma_end_to_end",
	"properties": {
		"description": "Master pipeline: bronze copy, then silver (Databricks), then gold (dbt)",
		"activities": [
			{
				"name": "exec_landing_to_bronze",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "pl_landing_to_bronze",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "dbx_silver_build",
				"description": "Runs Databricks job silver_build (bronze to silver)",
				"type": "DatabricksJob",
				"dependsOn": [
					{
						"activity": "exec_landing_to_bronze",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"jobId": "642258982925940"
				},
				"linkedServiceName": {
					"referenceName": "ls_databricks",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "web_dbt_gold_build",
				"description": "Triggers dbt Cloud job Gold build (silver to gold)",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "web_get_dbt_token",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Authorization": {
							"value": "@concat('Token ', activity('web_get_dbt_token').output.value)",
							"type": "Expression"
						},
						"Content-Type": "application/json"
					},
					"url": "https://ue536.us1.dbt.com/api/v2/accounts/70506183165571/jobs/70506183140474/run/",
					"body": {
						"cause": "Triggered by ADF pl_pharma_end_to_end"
					}
				}
			},
			{
				"name": "web_get_dbt_token",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "dbx_silver_build",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://kv-pharma-sruthi.vault.azure.net/secrets/dbt-service-token?api-version=7.4",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-09-27T00:12:33Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}